{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static site - no build step'",
  "outputDirectory": ".",
  "routes": [
    { "src": "/style.css", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/style.css" },
    { "src": "/script.js", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/script.js" },
    { "src": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
